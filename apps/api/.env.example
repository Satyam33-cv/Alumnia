    # Database
DATABASE_URL="postgresql://user:password@localhost:5432/alumnia?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
WEB_URL="http://localhost:3000"

# Seed script (npm run seed)
ADMIN_EMAIL="admin@college.edu"
ADMIN_PASSWORD="Admin@12345"

# CSV import: temp password for imported alumni
CSV_TEMP_PASSWORD="Welcome@2026"

# ---- Phase 4: Comms & Files (all OPTIONAL — features fall back to console logs / local storage) ----

# SendGrid transactional email
SENDGRID_API_KEY=""
EMAIL_FROM="Alumnia <no-reply@yourdomain.com>"

# Twilio WhatsApp alerts (E.164 phone numbers in user profiles)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155552671"

# Cloudinary file storage (resume uploads). Without these, files save locally under apps/api/uploads/
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Phase 5: AI Smart Matching (OPTIONAL) ----
# OpenAI embeddings (text-embedding-3-small, 384-dim). Without this key the API uses a
# deterministic local hashing embedding — matching works, quality improves with the key.
OPENAI_API_KEY=""
